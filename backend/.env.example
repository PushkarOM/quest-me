# Environment configuration for Quest Me backend
# Ollama base URL for vision and inference services. Replace with your actual Ollama server URL.
OLLAMA_BASE_URL=https://
# Vision model name (e.g., llava:latest)
VISION_MODEL=llava:latest
# Inference model name (used for quest generation)
QUEST_MODEL=qwen3-coder:480b-cloud
# Set inference mode: "ollama" or "cloud"
INFERENCE_MODE=ollama
